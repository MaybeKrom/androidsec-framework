# Python bytecode / caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
venv/
.venv/
env/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Scan / exploit outputs (regenerated locally)
output_reports/
exploitations/

# Per-scan assessment + exploitation evidence bundles
scans/

# APKs uploaded through the web UI, and cached package info
webapp/uploads/*.apk
webapp/uploads/*.part
webapp/meta/*.json
webapp/meta/*.tmp

# Decoded APK trees from the web UI
webapp/decoded/

# Runtime evidence and local DBs (API keys are never written here)
webapp/evidence/**
!webapp/evidence/.gitkeep
webapp/reviews.sqlite
webapp/exploits.sqlite

# Androguard cache
.androidsec/

# Distribution / packaging
dist/
build/
*.egg-info/
